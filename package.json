{
  "name": "dafkedd-eid-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Belgian eID reading for hosted Next.js/React apps (DafkeDD_EID)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @dafkedd/eid",
    "typecheck": "tsc -p packages/eid/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.mts",
    "check": "npm run typecheck && npm test && npm run build",
    "bridge": "node packages/eid/dist/cli.js serve",
    "bridge:mock": "node packages/eid/dist/cli.js serve --mock",
    "playground": "npm run dev -w @dafkedd/eid-playground",
    "build:playground": "npm run build && npm run build -w @dafkedd/eid-playground",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
